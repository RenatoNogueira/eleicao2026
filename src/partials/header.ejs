<header>
  <div class="top">
    <div class="brand">
      <img class="flag" src="<%- flagUri %>" alt="Bandeira do Maranhão" width="57" height="38">
      <div><h1>Dashboard MA</h1><p>Braide × Orleans · resultado por município</p></div>
    </div>
    <div class="gsearch">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="gs" placeholder="Pesquisar município…" autocomplete="off"><span class="kbd">/</span>
      <div class="sugg" id="sugg"></div>
    </div>
    <button class="icon-btn" id="theme" title="Alternar tema" aria-label="Alternar tema">◐</button>
  </div>
  <nav id="nav">
    <button data-v="overview" class="on"><span class="lg">Visão geral</span><span class="sm">Geral</span></button>
    <button data-v="map">Mapa</button>
    <button data-v="cities"><span class="lg">Municípios</span><span class="sm">Cidades</span></button>
    <button data-v="compare">Comparar</button>
    <button data-v="analysis">Análises</button>
    <button data-v="secoes"><span class="lg">Zonas e seções</span><span class="sm">Seções</span></button>
    <button data-v="deps">Legislativo</button>
  </nav>
</header>