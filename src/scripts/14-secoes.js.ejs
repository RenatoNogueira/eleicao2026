/* ---------- zonas e secoes ---------- */
const SECJ=JSON.parse($('#secoes-data').textContent);
const SEC=(()=>{const j=SECJ;return j.rows.map((r,i)=>({i,code:j.mun[r[0]],zona:r[1],secao:r[2],a:r[3],b:r[4],o:r[5],br:r[6],nu:r[7],k:r[8]||0}))})();
/* locais de votacao (data/locais.json, alinhado por posicao a SEC): carregado em segundo plano */
const LOC={st:'load'};
fetch('data/locais.json'+(SECJ.ver&&SECJ.ver.locais?'?v='+SECJ.ver.locais:'')).then(r=>{if(!r.ok)throw new Error(r.status);return r.json()}).then(j=>{
  if(j.s.length!==SEC.length)throw new Error('locais divergentes');
  LOC.l=j.locs;LOC.s=j.s;LOC.k=new Array(SEC.length);LOC.st='ok';
}).catch(()=>{LOC.st='err'}).then(()=>{if($('#v-secoes').classList.contains('on'))renderSecoes()});
function sLocOf(i){
  if(LOC.st!=='ok'||i===undefined)return null;
  const s=LOC.s[i],l=LOC.l[s[0]];
  return {nome:l[0],end:l[1],bairro:l[2],cep:l[3],lat:l[4],lon:l[5],tipo:l[6],el:s[1],ac:s[2],ag:s[3],elAg:s[4]};
}
const sEsc=t=>String(t==null?'':t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const sLocName=i=>{const l=sLocOf(i);return l?l.nome:''};
const sLocCols=(d,z)=>{if(z)return [];const l=sLocOf(d.i);return l?[l.nome,l.end,l.bairro]:['','','']};
const sLocTd=d=>{const l=sLocOf(d.i);return `<td data-l="Local de votação" class="sloc">${l?`<b>${sEsc(title(l.nome))}</b><small>${sEsc(title(l.bairro))}</small>`:'<small>—</small>'}</td>`};
const sName=c=>byCode[c]?byCode[c].name:c;
let SS={cg:'gov',cand:'',loc:'',mun:'all',zona:'all',sec:'',lead:'all',group:'sec',sort:'name',dir:1,page:0,per:25};
const sCols={
  sec:[['name','Município'],['zona','Zona','r'],['secao','Seção','r'],['local','Local de votação'],['a','Braide','r'],['b','Orleans','r'],['diff','Diferença','r'],['bn','Brancos · nulos','r'],['lead','Líder']],
  zona:[['name','Município'],['zona','Zona','r'],['n','Seções','r'],['a','Braide','r'],['b','Orleans','r'],['diff','Diferença','r'],['bn','Brancos · nulos','r'],['lead','Líder']]
};
function sRow(o){const t=o.a+o.b+(o.k||0)+(o.o||0);return {...o,bn:o.br+o.nu,name:sName(o.code),local:sLocName(o.i),t,pa:t?o.a/t*100:0,pb:t?o.b/t*100:0,diff:o.a-o.b,lead:o.a>o.b?'a':o.b>o.a?'b':'e'}}
function sBase(){ /* filtros de municipio, zona e secao (aplicados as secoes) */
  const n=SS.sec===''?null:parseInt(SS.sec,10);
  const q=norm(SS.loc.trim());
  const hasLoc=s=>{if(!q)return true;if(LOC.st!=='ok')return false;const k=LOC.k[s.i]||(LOC.k[s.i]=norm(sLocName(s.i)+' '+LOC.l[LOC.s[s.i][0]][1]+' '+LOC.l[LOC.s[s.i][0]][2]));return k.includes(q)};
  return SEC.filter(s=>(SS.mun==='all'||s.code===SS.mun)&&(SS.zona==='all'||s.zona===SS.zona)&&(n===null||parseInt(s.secao,10)===n)&&hasLoc(s));
}
function sRows(){
  let r;
  if(SS.group==='zona'){
    const m=new Map();
    sBase().forEach(s=>{const k=s.code+'|'+s.zona;const g=m.get(k)||m.set(k,{code:s.code,zona:s.zona,n:0,a:0,b:0,k:0,o:0,br:0,nu:0}).get(k);g.n++;g.a+=s.a;g.b+=s.b;g.k+=s.k;g.o+=s.o;g.br+=s.br;g.nu+=s.nu});
    r=[...m.values()].map(sRow);
  }else r=sBase().map(sRow);
  if(SS.lead!=='all')r=r.filter(x=>x.lead===SS.lead);
  const k=SS.sort;
  const cmp=(x,y,f)=>{const u=x[f],v=y[f];return typeof u==='string'?u.localeCompare(v,'pt-BR'):u-v};
  r.sort((x,y)=>(cmp(x,y,k)||cmp(x,y,'name')||cmp(x,y,'zona')||cmp(x,y,'secao'))*SS.dir);
  return r;
}
/* mensagem de vazio: explica qual filtro zerou o resultado (ex.: chip de lider) */
function sEmptyMsg(){
  const un=SS.group==='zona'?'zona':'seção';
  if(SS.lead!=='all'){
    const l=SS.lead;SS.lead='all';const all=sRows();SS.lead=l;
    if(all.length){const o=all[0],w=o.lead==='a'?'b':'a';
      return `Nenhuma ${un} com ${NAME[l]} na frente neste recorte. ${all.length===1?'O único resultado tem '+(o.lead==='e'?'empate':NAME[o.lead]+' na frente ('+fmt(o.a)+' × '+fmt(o.b)+')'):all.length+' resultados têm outro líder'}. <button class="btn" onclick="SS.lead='all';SS.page=0;sSync();renderSecoes()">Mostrar todos</button>`}
  }
  return `Nenhuma ${un} encontrada para os filtros aplicados. <button class="btn" onclick="$('#sClear').click()">Limpar filtros</button>`;
}
function sFillZonas(){
  const zs=new Set();(SS.mun==='all'?SEC:SEC.filter(s=>s.code===SS.mun)).forEach(s=>zs.add(s.zona));
  const l=[...zs].sort();if(SS.zona!=='all'&&!zs.has(SS.zona))SS.zona='all';
  $('#sZona').innerHTML='<option value="all">Todas as zonas</option>'+l.map(z=>`<option value="${z}">Zona ${parseInt(z,10)}</option>`).join('');
  $('#sZona').value=SS.zona;
}
function renderSecoes(){
  if(SS.cg!=='gov')return renderSecoesCargo();
  const cols=sCols[SS.group];if(!cols.some(c=>c[0]===SS.sort))SS.sort='name';
  $('#sTbl thead').innerHTML='<tr>'+cols.map(c=>`<th data-k="${c[0]}" class="${c[2]||''} ${SS.sort===c[0]?'s':''}">${c[1]}<span class="ar">${SS.dir>0?'▲':'▼'}</span></th>`).join('')+'</tr>';
  const r=sRows(),pages=Math.max(1,Math.ceil(r.length/SS.per));SS.page=Math.min(SS.page,pages-1);
  const un=SS.group==='zona'?'zonas':'seções';
  $('#sTbl tbody').innerHTML=r.length?r.slice(SS.page*SS.per,(SS.page+1)*SS.per).map(d=>`<tr data-c="${d.code}" data-i="${SS.group==='sec'?d.i:''}"><td class="cname"><b>${title(d.name)}</b></td><td class="r num" data-l="Zona">${parseInt(d.zona,10)}</td><td class="r num" data-l="${SS.group==='zona'?'Seções':'Seção'}">${SS.group==='zona'?fmt(d.n):d.secao}</td>${SS.group==='sec'?sLocTd(d):''}<td class="r num" data-l="Braide"><b>${fmt(d.a)}</b><small>${pp(d.pa)}%</small></td><td class="r num" data-l="Orleans"><b>${fmt(d.b)}</b><small>${pp(d.pb)}%</small></td><td class="r num ${d.diff>0?'pos':d.diff<0?'neg':''}" data-l="Diferença">${d.diff>0?'+':d.diff<0?'−':''}${fmt(Math.abs(d.diff))}</td><td class="r num" data-l="Brancos · nulos"><b>${fmt(d.br+d.nu)}</b><small>${fmt(d.br)} · ${fmt(d.nu)}</small></td><td class="clead">${d.lead==='e'?'<span class="tag">Empate</span>':`<span class="tag ${d.lead}">${NAME[d.lead]}</span>`}</td></tr>`).join(''):`<tr><td colspan="9" class="cempty"><div class="empty">${sEmptyMsg()}</div></td></tr>`;
  $('#sCount').textContent=`${fmt(r.length)} ${un}`;
  $('#sPinfo').textContent=r.length?`Mostrando ${SS.page*SS.per+1}–${Math.min(r.length,(SS.page+1)*SS.per)} de ${fmt(r.length)}`:'';
  $('#sPbtn').innerHTML=`<button class="btn" id="spp" ${SS.page==0?'disabled':''}>← Anterior</button><span style="align-self:center">${SS.page+1} / ${pages}</span><button class="btn" id="spn" ${SS.page>=pages-1?'disabled':''}>Próxima →</button>`;
  /* totais do recorte filtrado (secoes) */
  const b=SS.group==='zona'?r:sRows(),tot=b.reduce((s,x)=>({a:s.a+x.a,b:s.b+x.b,k:s.k+(x.k||0),o:s.o+(x.o||0),br:s.br+x.br,nu:s.nu+x.nu,n:s.n+(x.n||1)}),{a:0,b:0,k:0,o:0,br:0,nu:0,n:0});
  const t=tot.a+tot.b+tot.k+tot.o,pa=t?tot.a/t*100:0,pb=t?tot.b/t*100:0,df=tot.a-tot.b;
  const scope=SS.mun==='all'?'Maranhão':title(sName(SS.mun));
  const kp=[
    ['tx','Seções',fmt(tot.n),`${scope}${SS.zona!=='all'?' · zona '+parseInt(SS.zona,10):''}`],
    ['a','Braide',fmt(tot.a),pc(pa,2)+' dos votos válidos'],
    ['b','Orleans',fmt(tot.b),pc(pb,2)+' dos votos válidos'],
    [df>=0?'a':'b','Diferença',`${df>0?'+':df<0?'−':''}${fmt(Math.abs(df))}`,`${fmt(tot.br)} brancos · ${fmt(tot.nu)} nulos`]
  ];
  $('#sKpis').innerHTML=kp.map(k=>`<div class="card kpi"><div class="lbl"><span class="dot" style="background:var(--${k[0]})"></span>${k[1]}</div><div class="val num">${k[2]}</div><div class="ft">${k[3]}</div></div>`).join('');
}
function sSync(){
  const g=SS.cg==='gov';
  $$('#sCargo button').forEach(c=>c.classList.toggle('on',c.dataset.cg===SS.cg));
  $('#sMun').value=SS.mun;sFillZonas();$('#sSec').value=SS.sec;$('#sLoc').value=SS.loc;
  $$('#sLead .chip').forEach(c=>c.classList.toggle('on',c.dataset.f===SS.lead));
  $$('#sGroup button').forEach(c=>c.classList.toggle('on',c.dataset.g===SS.group));
  $('#sLead').style.display=g?'':'none';$('#sCandBox').style.display=g?'none':'';
  if(!SS.cand)$('#sCand').value='';
}
function showSecoes(code){closeDrawer();SS={...SS,mun:code,zona:'all',sec:'',lead:'all',page:0};sSync();go('secoes');renderSecoes()}
(()=>{
  const ms=[...new Set(SEC.map(s=>s.code))].sort((x,y)=>sName(x).localeCompare(sName(y),'pt-BR'));
  $('#sMun').insertAdjacentHTML('beforeend',ms.map(c=>`<option value="${c}">${title(sName(c))}</option>`).join(''));
  sFillZonas();
})();
$('#sMun').onchange=e=>{SS.mun=e.target.value;SS.zona='all';SS.page=0;sFillZonas();renderSecoes()};
$('#sLoc').oninput=e=>{SS.loc=e.target.value;SS.page=0;renderSecoes()};
$('#sZona').onchange=e=>{SS.zona=e.target.value;SS.page=0;renderSecoes()};
$('#sSec').oninput=e=>{SS.sec=e.target.value.replace(/\D/g,'').slice(0,4);e.target.value=SS.sec;SS.page=0;renderSecoes()};
$('#sLead').onclick=e=>{const b=e.target.closest('.chip');if(!b)return;SS.lead=b.dataset.f;SS.page=0;sSync();renderSecoes()};
$('#sGroup').onclick=e=>{const b=e.target.closest('button');if(!b)return;SS.group=b.dataset.g;SS.page=0;SS.sort='name';SS.dir=1;sSync();renderSecoes()};
$('#sClear').onclick=()=>{SS={...SS,mun:'all',zona:'all',sec:'',loc:'',lead:'all',cand:'',page:0};sSync();renderSecoes()};
$('#sTbl').onclick=e=>{const tr=e.target.closest('tbody tr');if(tr&&tr.dataset.i){openSecao(+tr.dataset.i);return}const th=e.target.closest('th');if(!th)return;const k=th.dataset.k;SS.dir=SS.sort===k?-SS.dir:(['name','lead','zona','secao','n','topName','topP'].includes(k)?1:-1);SS.sort=k;SS.page=0;renderSecoes()};
$('#sPbtn').onclick=e=>{if(e.target.id==='spp')SS.page--;if(e.target.id==='spn')SS.page++;renderSecoes()};
$('#sExp').onclick=()=>{
  if(SS.cg!=='gov')return sExportCargo();
  const z=SS.group==='zona',rows=sRows();
  const h=['codigo_municipio','municipio','zona',z?'secoes':'secao','braide','pct_braide','orleans','pct_orleans','diferenca','brancos','nulos','lider'].concat(z?[]:['local_votacao','endereco','bairro']);
  const csv=[h.join(';'),...rows.map(d=>[d.code,d.name,d.zona,z?d.n:d.secao,d.a,d.pa.toFixed(2).replace('.',','),d.b,d.pb.toFixed(2).replace('.',','),d.diff,d.br,d.nu,d.lead==='e'?'Empate':NAME[d.lead]].concat(sLocCols(d,z)).join(';'))].join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv'}));a.download=z?'zonas_filtradas.csv':'secoes_filtradas.csv';a.click();
};

/* ----- Senador / Deputado Federal / Deputado Estadual (votos nominais por secao, carregados sob demanda) ----- */
const SECD={};
function sCargoData(){
  const cg=SS.cg;
  if(SECD[cg])return SECD[cg];
  const o=SECD[cg]={st:'load'};
  fetch('data/secoes_'+cg+'.json'+(SECJ.ver&&SECJ.ver[cg]?'?v='+SECJ.ver[cg]:'')).then(r=>{if(!r.ok)throw new Error(r.status);return r.json()}).then(j=>{
    if(j.n!==SEC.length)throw new Error('secoes divergentes');
    const vt=new Int32Array(j.n);
    for(const k in j.c){const a=j.c[k];for(let i=0;i<a.length;i+=2)vt[a[i]]+=a[i+1]}
    Object.assign(o,{c:j.c,br:j.br,nu:j.nu,vtot:vt,st:'ok'});
  }).catch(()=>{o.st='err'}).then(()=>{if(SS.cg===cg)renderSecoes()});
  return o;
}
const sCandOf=(cg,n)=>{const d=depLoad(cg);return (d.byNum||(d.byNum=new Map(d.cands.map(c=>[String(c.n),c])))).get(String(n))};
function sCargoRows(o){
  const d=depLoad(SS.cg),N=SEC.length,base=sBase(),withC=!!SS.cand;
  const party=c=>c?d.parties[c.p].sg:'';
  let rows;
  if(SS.group==='sec'){
    if(withC){
      const v=new Int32Array(N),a=o.c[SS.cand]||[];for(let k=0;k<a.length;k+=2)v[a[k]]=a[k+1];
      rows=base.map(s=>({i:s.i,code:s.code,zona:s.zona,secao:s.secao,v:v[s.i],valid:o.vtot[s.i],br:o.br[s.i],nu:o.nu[s.i]}));
    }else{
      if(!o.topN){o.topN=new Array(N);o.topV=new Int32Array(N);
        for(const k in o.c){const a=o.c[k];for(let i=0;i<a.length;i+=2){const x=a[i];if(a[i+1]>o.topV[x]){o.topV[x]=a[i+1];o.topN[x]=k}}}}
      rows=base.map(s=>({i:s.i,code:s.code,zona:s.zona,secao:s.secao,top:o.topN[s.i],v:o.topV[s.i],valid:o.vtot[s.i],br:o.br[s.i],nu:o.nu[s.i]}));
    }
  }else{
    const m=new Map(),zr=new Array(N);
    base.forEach(s=>{const k=s.code+'|'+s.zona;let g=m.get(k);if(!g)m.set(k,g={code:s.code,zona:s.zona,n:0,v:0,valid:0,br:0,nu:0});g.n++;g.valid+=o.vtot[s.i];g.br+=o.br[s.i];g.nu+=o.nu[s.i];zr[s.i]=g});
    if(withC){const a=o.c[SS.cand]||[];for(let k=0;k<a.length;k+=2){const g=zr[a[k]];if(g)g.v+=a[k+1]}}
    else{for(const k in o.c){const a=o.c[k];for(let i=0;i<a.length;i+=2){const g=zr[a[i]];if(g){const mm=g.m||(g.m=new Map());mm.set(k,(mm.get(k)||0)+a[i+1])}}}
      m.forEach(g=>{let tv=0,tn='';if(g.m)g.m.forEach((v,k)=>{if(v>tv){tv=v;tn=k}});g.top=tn;g.v=tv;g.m=null})}
    rows=[...m.values()];
  }
  rows.forEach(r=>{r.name=sName(r.code);r.local=r.i===undefined?'':sLocName(r.i);r.bn=r.br+r.nu;r.pct=r.valid?r.v/r.valid*100:0;
    if(!withC){const c=r.top?sCandOf(SS.cg,r.top):null;r.topName=c?c.nu:(r.top||'—');r.topP=party(c)}});
  const k=SS.sort,cmp=(x,y,f)=>{const u=x[f],v=y[f];return typeof u==='string'?u.localeCompare(v,'pt-BR'):(u||0)-(v||0)};
  rows.sort((x,y)=>(cmp(x,y,k)||cmp(x,y,'name')||cmp(x,y,'zona')||cmp(x,y,'secao'))*SS.dir);
  return rows;
}
function sCargoCols(){
  const z=SS.group==='zona',b=[['name','Município'],['zona','Zona','r'],z?['n','Seções','r']:['secao','Seção','r']].concat(z?[]:[['local','Local de votação']]);
  return b.concat(SS.cand
    ?[['v','Votos','r'],['pct','% dos válidos','r'],['valid','Válidos','r'],['bn','Brancos · nulos','r']]
    :[['topName','Mais votado'],['v','Votos','r'],['pct','% dos válidos','r'],['bn','Brancos · nulos','r']]);
}
function renderSecoesCargo(){
  const o=sCargoData(),cols=sCargoCols(),z=SS.group==='zona';
  if(!cols.some(c=>c[0]===SS.sort))SS.sort='name';
  $('#sTbl thead').innerHTML='<tr>'+cols.map(c=>`<th data-k="${c[0]}" class="${c[2]||''} ${SS.sort===c[0]?'s':''}">${c[1]}<span class="ar">${SS.dir>0?'▲':'▼'}</span></th>`).join('')+'</tr>';
  if(o.st!=='ok'){
    $('#sTbl tbody').innerHTML=`<tr><td colspan="${cols.length}" class="cempty"><div class="empty">${o.st==='load'?'Carregando votos por seção…':'Não foi possível carregar os dados desta eleição (abra o painel por um servidor, não pelo arquivo local).'}</div></td></tr>`;
    $('#sKpis').innerHTML='';$('#sCount').textContent='';$('#sPinfo').textContent='';$('#sPbtn').innerHTML='';return;
  }
  const r=sCargoRows(o),pages=Math.max(1,Math.ceil(r.length/SS.per));SS.page=Math.min(SS.page,pages-1);
  const cell=(d,k)=>{
    switch(k){
      case 'name':return `<td class="cname"><b>${title(d.name)}</b></td>`;
      case 'zona':return `<td class="r num" data-l="Zona">${parseInt(d.zona,10)}</td>`;
      case 'secao':return `<td class="r num" data-l="Seção">${d.secao}</td>`;
      case 'local':return sLocTd(d);
      case 'n':return `<td class="r num" data-l="Seções">${fmt(d.n)}</td>`;
      case 'topName':return `<td data-l="Mais votado" class="sloc"><b>${title(d.topName)}</b><small>${d.topP}</small></td>`;
      case 'v':return `<td class="r num" data-l="Votos">${fmt(d.v)}</td>`;
      case 'pct':return `<td class="r num" data-l="% dos válidos">${pp(d.pct)}%</td>`;
      case 'valid':return `<td class="r num" data-l="Válidos">${fmt(d.valid)}</td>`;
      default:return `<td class="r num" data-l="Brancos · nulos"><b>${fmt(d.br+d.nu)}</b><small>${fmt(d.br)} · ${fmt(d.nu)}</small></td>`;
    }
  };
  $('#sTbl tbody').innerHTML=r.length?r.slice(SS.page*SS.per,(SS.page+1)*SS.per).map(d=>'<tr data-c="'+d.code+'" data-i="'+(z?'':d.i)+'">'+cols.map(c=>cell(d,c[0])).join('')+'</tr>').join(''):`<tr><td colspan="${cols.length}" class="cempty"><div class="empty">Nenhuma ${z?'zona':'seção'} encontrada.</div></td></tr>`;
  $('#sCount').textContent=`${fmt(r.length)} ${z?'zonas':'seções'}`;
  $('#sPinfo').textContent=r.length?`Mostrando ${SS.page*SS.per+1}–${Math.min(r.length,(SS.page+1)*SS.per)} de ${fmt(r.length)}`:'';
  $('#sPbtn').innerHTML=`<button class="btn" id="spp" ${SS.page==0?'disabled':''}>← Anterior</button><span style="align-self:center">${SS.page+1} / ${pages}</span><button class="btn" id="spn" ${SS.page>=pages-1?'disabled':''}>Próxima →</button>`;
  /* KPIs do recorte */
  const t=r.reduce((s,x)=>({n:s.n+(x.n||1),v:s.v+x.v,valid:s.valid+x.valid,br:s.br+x.br,nu:s.nu+x.nu}),{n:0,v:0,valid:0,br:0,nu:0});
  const scope=(SS.mun==='all'?'Maranhão':title(sName(SS.mun)))+(SS.zona!=='all'?' · zona '+parseInt(SS.zona,10):'');
  let kp;
  if(SS.cand){
    const c=sCandOf(SS.cg,SS.cand);
    kp=[['tx','Seções',fmt(t.n),scope],['a',c?title(c.nu):SS.cand,fmt(t.v),(c?d_p(c)+' · ':'')+'votos no recorte'],['b','% dos válidos',pc(t.valid?t.v/t.valid*100:0,2),fmt(t.valid)+' votos válidos'],['tx','Brancos · nulos',fmt(t.br+t.nu),fmt(t.br)+' brancos · '+fmt(t.nu)+' nulos']];
  }else{
    const base=sBase(),mask=new Uint8Array(SEC.length);base.forEach(s=>mask[s.i]=1);
    let bn='',bv=0;for(const k in o.c){const a=o.c[k];let sum=0;for(let i=0;i<a.length;i+=2)if(mask[a[i]])sum+=a[i+1];if(sum>bv){bv=sum;bn=k}}
    const c=bn?sCandOf(SS.cg,bn):null;
    kp=[['tx','Seções',fmt(base.length),scope],['b','Votos válidos',fmt(base.reduce((s,x)=>s+o.vtot[x.i],0)),'votos nominais'],['a','Mais votado',c?title(c.nu):'—',c?(d_p(c)+' · '+fmt(bv)+' votos'):''],['tx','Brancos · nulos',fmt(base.reduce((s,x)=>s+o.br[x.i]+o.nu[x.i],0)),'no recorte']];
  }
  $('#sKpis').innerHTML=kp.map(k=>`<div class="card kpi"><div class="lbl"><span class="dot" style="background:var(--${k[0]})"></span>${k[1]}</div><div class="val num" style="font-size:${k[2].length>12?'20px':''}">${k[2]}</div><div class="ft">${k[3]}</div></div>`).join('');
}
const d_p=c=>depLoad(SS.cg).parties[c.p].sg;
function sExportCargo(){
  const o=SECD[SS.cg];if(!o||o.st!=='ok')return;
  const z=SS.group==='zona',r=sCargoRows(o),w=!!SS.cand;
  const h=['codigo_municipio','municipio','zona',z?'secoes':'secao'].concat(w?['votos','pct_validos','validos']:['mais_votado','partido','votos','pct_validos']).concat(['brancos','nulos'],z?[]:['local_votacao','endereco','bairro']);
  const csv=[h.join(';'),...r.map(d=>[d.code,d.name,d.zona,z?d.n:d.secao].concat(w?[d.v,d.pct.toFixed(2).replace('.',','),d.valid]:[d.topName,d.topP,d.v,d.pct.toFixed(2).replace('.',',')]).concat([d.br,d.nu],sLocCols(d,z)).join(';'))].join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv'}));a.download=SS.cg+(z?'_zonas':'_secoes')+'.csv';a.click();
}
$('#sCargo').onclick=e=>{const b=e.target.closest('button');if(!b)return;SS.cg=b.dataset.cg;SS.cand='';SS.page=0;SS.sort='name';SS.dir=1;sSync();renderSecoes()};
(()=>{
  const inp=$('#sCand'),box=$('#sCandSugg');let hl=-1,items=[];
  const draw=()=>{
    const q=norm(inp.value.trim()),d=depLoad(SS.cg);
    items=(q?d.cands.filter(c=>c.key.includes(q)):d.cands).slice(0,8);
    box.innerHTML=items.length?items.map((c,i)=>`<button data-n="${c.n}" class="${i===hl?'hl':''}"><span>${title(c.nu)} <small>${c.n}</small></span><span class="tag">${d.parties[c.p].sg}</span></button>`).join(''):'<div class="empty" style="padding:16px">Sem resultados</div>';
    box.classList.add('on');
  };
  const pick=n=>{const c=sCandOf(SS.cg,n);if(!c)return;SS.cand=String(c.n);inp.value=title(c.nu)+' · '+c.n;box.classList.remove('on');SS.page=0;SS.sort='v';SS.dir=-1;renderSecoes()};
  inp.addEventListener('input',()=>{hl=-1;if(!inp.value.trim()&&SS.cand){SS.cand='';SS.page=0;SS.sort='name';SS.dir=1;renderSecoes()}draw()});
  inp.addEventListener('focus',()=>{inp.select();draw()});
  inp.addEventListener('keydown',e=>{if(e.key==='ArrowDown'){hl=Math.min(items.length-1,hl+1);draw();e.preventDefault()}else if(e.key==='ArrowUp'){hl=Math.max(0,hl-1);draw();e.preventDefault()}else if(e.key==='Enter'&&items.length){pick(items[Math.max(0,hl)].n)}else if(e.key==='Escape'){box.classList.remove('on');inp.blur()}});
  box.addEventListener('mousedown',e=>{const b=e.target.closest('button');if(b){e.preventDefault();pick(b.dataset.n)}});
  inp.addEventListener('blur',()=>setTimeout(()=>box.classList.remove('on'),120));
})();

/* ----- gaveta com os detalhes da secao (local de votacao, eleitorado, resultado) ----- */
function openSecao(i){
  const s=SEC[i],L=sLocOf(i),nom=s.a+s.b+s.k+s.o,tot=nom+s.br+s.nu;
  const apt=L?L.el+L.elAg:0,pa=nom?s.a/nom*100:0,pb=nom?s.b/nom*100:0;
  const row=(k,v)=>v?`<div style="display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13px"><span style="color:var(--tx2)">${k}</span><span style="text-align:right;font-weight:600">${v}</span></div>`:'';
  let det='';
  if(L){
    const ag=L.ag?L.ag.split(','):[];
    const map=L.lat&&L.lat!=='-1'?`<a class="btn" target="_blank" rel="noopener" style="text-decoration:none" href="https://www.openstreetmap.org/?mlat=${encodeURIComponent(L.lat)}&mlon=${encodeURIComponent(L.lon)}#map=17/${encodeURIComponent(L.lat)}/${encodeURIComponent(L.lon)}">Ver no mapa ↗</a>`:'';
    det=`<div style="margin-top:18px">${row('Endereço',sEsc(title(L.end)))}${row('Bairro / localidade',sEsc(title(L.bairro)))}${row('CEP',sEsc(L.cep))}${row('Tipo de local',sEsc(L.tipo))}${row('Acessibilidade',L.ac?'Seção com acessibilidade':'Sem acessibilidade')}${row('Eleitores da seção',fmt(L.el))}${ag.length?row('Seções agregadas',ag.join(', ')+' ('+fmt(L.elAg)+' eleitores)'):''}${row('Eleitorado apto (total)',fmt(apt))}</div>${map?'<div style="margin-top:14px">'+map+'</div>':''}`;
  }else det='<p class="sub" style="margin-top:18px">Dados do local de votação indisponíveis.</p>';
  const comp=apt?`${pc(tot/apt*100,1)} do eleitorado`:'';
  let cg='';
  const o=SS.cg!=='gov'?SECD[SS.cg]:null;
  if(o&&o.st==='ok'){
    const d=depLoad(SS.cg),l=[];
    for(const k in o.c){const a=o.c[k];for(let j=0;j<a.length;j+=2)if(a[j]===i){l.push([k,a[j+1]]);break}}
    l.sort((x,y)=>y[1]-x[1]);
    cg=`<h3 style="margin:22px 0 4px">${{senador:'Senador',federal:'Deputado Federal',estadual:'Deputado Estadual'}[SS.cg]} · mais votados na seção</h3>`+l.slice(0,6).map(([n,v])=>{const c=sCandOf(SS.cg,n);return row(sEsc(c?title(c.nu)+' · '+d.parties[c.p].sg:n),fmt(v)+' <small style="color:var(--tx3)">'+pp(o.vtot[i]?v/o.vtot[i]*100:0)+'%</small>')}).join('');
  }
  $('#drawer').innerHTML=`<button class="icon-btn x" onclick="closeDrawer()" aria-label="Fechar">✕</button>
   <span class="tag ${s.a>s.b?'a':s.b>s.a?'b':''}">Zona ${parseInt(s.zona,10)} · Seção ${parseInt(s.secao,10)}</span>
   <h2>${L?sEsc(title(L.nome)):'Seção '+parseInt(s.secao,10)}</h2><p style="color:var(--tx2);font-size:13px">${sEsc(title(sName(s.code)))} · código TSE ${s.code}</p>
   <h3 style="margin:20px 0 6px">Governador · resultado da seção</h3>
   <div class="bar"><i class="a" style="width:${pa}%" data-w="${pa}"></i><i class="b" style="width:${pb}%" data-w="${pb}"></i></div>
   <div style="display:flex;justify-content:space-between;margin-top:8px;font-weight:700"><span style="color:var(--a)">${pc(pa,1)}</span><span style="color:var(--b)">${pc(pb,1)}</span></div>
   <div class="stat">
     <div><small>Braide</small><b class="num">${fmt(s.a)}</b></div><div><small>Orleans</small><b class="num">${fmt(s.b)}</b></div>
     <div><small>Felipe Camarão</small><b class="num">${fmt(s.k)}</b><small style="display:block">${pc(nom?s.k/nom*100:0,1)}</small></div><div><small>Outros candidatos</small><b class="num">${fmt(s.o)}</b></div>
     <div><small>Votos válidos</small><b class="num">${fmt(nom)}</b></div><div><small>Brancos · nulos</small><b class="num">${fmt(s.br)} · ${fmt(s.nu)}</b></div>
     <div><small>Comparecimento</small><b class="num">${fmt(tot)}</b><small style="display:block">${comp}</small></div><div><small>Abstenção</small><b class="num">${apt?fmt(Math.max(0,apt-tot)):'—'}</b></div>
   </div>
   ${det}${cg}`;
  $('#drawer').classList.add('on');$('#scrim').classList.add('on');$('#drawer').setAttribute('aria-hidden','false');
}
