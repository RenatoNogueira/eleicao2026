<%- include('scripts/09-search-boxes.js.ejs') %>
<%- include('scripts/10-compare.js.ejs') %>
<%- include('scripts/11-analysis.js.ejs') %>
<%- include('scripts/12-deputados.js.ejs') %>
<%- include('scripts/14-secoes.js.ejs') %>
<%- include('scripts/15-presidente.js.ejs') %>
<%- include('scripts/13-init.js.ejs') %>
</script>
