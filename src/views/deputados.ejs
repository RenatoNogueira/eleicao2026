<section class="view" id="v-deps">
  <div class="toolbar">
    <div class="seg" id="depCargo">
      <button data-c="federal" class="on">Deputado Federal</button>
      <button data-c="estadual">Deputado Estadual</button>
    </div>
    <span class="sp"></span>
    <span id="depNote" style="font-size:13px;color:var(--tx2)"></span>
  </div>

  <div class="grid g4" id="depKpis"></div>

  <div class="sec-title">Eleitos</div>
  <div class="card">
    <div class="card-head">
      <div><h3 id="depElT">Eleitos</h3><p class="sub" id="depElS"></p></div>
      <button class="btn" id="depElMore"></button>
    </div>
    <div class="elected" id="depElected"></div>
  </div>

  <div class="sec-title">Partidos e federações</div>
  <div class="grid g2">
    <div class="card"><h3>Votos por partido</h3><p class="sub">Votos nominais + votos de legenda (12 maiores)</p><div class="ch tall"><canvas id="dChVotes"></canvas></div></div>
    <div class="card"><h3>Cadeiras conquistadas</h3><p class="sub" id="depSeatsSub">Eleitos por partido</p><div class="ch tall"><canvas id="dChSeats"></canvas></div></div>
  </div>

  <div class="sec-title">Mapa de votos por candidato</div>
  <div class="grid g-21">
    <div class="card">
      <div class="toolbar" style="margin-bottom:10px">
        <div class="gsearch" style="max-width:none;flex:1 1 240px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="depMapSearch" placeholder="Buscar candidato, número ou partido…" autocomplete="off"><div class="sugg" id="depMapSugg"></div>
        </div>
        <div class="seg" id="depMetric"><button data-m="pct" class="on">% do município</button><button data-m="votes">Votos</button></div>
      </div>
      <div class="mapbox" id="depMap"></div>
      <div class="legend" id="depLegend"></div>
    </div>
    <div style="display:grid;gap:16px;align-content:start">
      <div class="card" id="depCandCard"></div>
      <div class="card" id="depMunCard"></div>
    </div>
  </div>

  <div class="sec-title">Candidatos</div>
  <div class="toolbar">
    <input class="input" id="depQ" placeholder="Filtrar por nome, número ou partido…" style="min-width:240px">
    <select class="input" id="depParty"><option value="all">Todos os partidos</option></select>
    <div class="chips" id="depOnly"><button class="chip on" data-f="all">Todos</button><button class="chip" data-f="e">Eleitos</button><button class="chip" data-f="s">Suplentes</button></div>
    <span class="sp"></span>
    <span id="depCount" style="font-size:13px;color:var(--tx2)"></span>
    <button class="btn" id="depExp">⬇ Exportar CSV</button>
  </div>
  <div class="tbl-wrap"><table id="depTbl"><thead></thead><tbody></tbody></table></div>
  <div class="pager"><span id="depPinfo"></span><div id="depPbtn"></div></div>

  <div class="sec-title">Comparar candidatos</div>
  <div class="card">
    <h3>Comparar candidatos</h3>
    <p class="sub">Escolha de 2 a 4 candidatos do cargo selecionado</p>
    <div class="picker">
      <div class="gsearch" style="max-width:320px;flex:none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="depCmpSearch" placeholder="Adicionar candidato…" autocomplete="off"><div class="sugg" id="depCmpSugg"></div>
      </div>
      <div id="depSels" class="picker"></div>
      <span class="sp"></span>
      <button class="btn" data-dpre="top">Top 4 votados</button>
      <button class="btn" data-dpre="party">Maiores de cada partido</button>
    </div>
  </div>
  <div id="depCmpBody"></div>
</section>
